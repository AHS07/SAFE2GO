APP_ENV=dev
# Local PostgreSQL. Write special characters in the password URL-encoded (@ becomes %40).
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/safe2go
JWT_SECRET=
CREDENTIAL_SIGNING_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SIM_SEED=42
SIM_SPEED=1
SIM_TICK_SECONDS=1
ETA_BUFFER_MINUTES=15
OFFLINE_CREDENTIAL_GRACE_MINUTES=60
SYNC_POLL_SECONDS=1
SYNC_BACKOFF_MAX_SECONDS=60
SYNC_DEAD_LETTER_AFTER_SECONDS=3600
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=safe2go.telemetry.raw
KAFKA_TOPIC_EVENTS=safe2go.safety.events
KAFKA_CONSUMER_GROUP=safe2go-cloud-analytics
STREAM_BATCH_SIZE=500
STREAM_MAX_RATE=2000
STREAM_SPOOL_MAX_RECORDS=250000
